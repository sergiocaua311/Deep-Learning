{
  "seed": 42,
  "screening": {
    "models": ["ast", "wav2vec2", "whisper", "cnn"],
    "train_folds": [1, 2, 3],
    "validation_fold": 4,
    "test_fold": 5,
    "max_epochs": 10,
    "early_stopping_patience": 2,
    "selection_metric": "f1_macro"
  },
  "cross_validation": {
    "folds": [1, 2, 3, 4, 5],
    "selected_models": 2,
    "fixed_hyperparameters": true,
    "selection_metric": "f1_macro_mean",
    "tie_breakers": ["accuracy_mean", "latency_ms_mean", "model_size_bytes"]
  },
  "robustness": {
    "conditions": ["clean", "shift_-0.5", "shift_0.5", "gain_-6", "gain_6", "noise_20", "noise_10", "noise_0"]
  }
}
